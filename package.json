{
  "name": "paos-us-vercel",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js frontend for the Pao Family WordPress migration.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "Hillwork, LLC",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.15",
    "@workermailer/smtp": "^0.2.1",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanitize-html": "^2.17.5",
    "simple-icons": "^16.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.1"
  }
